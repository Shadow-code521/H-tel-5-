#include <stdio.h>
#include <stdbool.h>

#define MAX_CHAMBRES_UN_LIT 300
#define MAX_CHAMBRES_DEUX_LITS 200
#define MAX_PLACES_RESTAURANT 175
#define MAX_PLACES_PISCINE 45
#define MAX_PLACES_SPA 20
#define MAX_PLACES_SAUNA 20
#define MAX_PLACES_SALLE_DE_SPORT 50
#define MAX_PLACES_MASSAGE 10
#define MAX_PLACES_CHAUFFEUR 5

// Structure pour stocker les informations sur les reservations
typedef struct {
    char service[50];
    int placesOccupees;
    int duree; // Duree en heures
} Reservation;

// Variables globales pour la disponibilite
int chambresUnLit = MAX_CHAMBRES_UN_LIT;
int chambresDeuxLits = MAX_CHAMBRES_DEUX_LITS;
int placesRestaurant = MAX_PLACES_RESTAURANT;
int placesPiscine = MAX_PLACES_PISCINE;
int placesSpa = MAX_PLACES_SPA;
int placesSauna = MAX_PLACES_SAUNA;
int placesSalleDeSport = MAX_PLACES_SALLE_DE_SPORT;
int placesMassage = MAX_PLACES_MASSAGE;
int placesChauffeur = MAX_PLACES_CHAUFFEUR;

// Tableau pour enregistrer les reservations
Reservation reservations[100];
int reservationCount = 0;

// Fonction pour vérifier le mot de passe
int verifier_mdp(char *mdp, char *mdp_verif) {
    if (strcmp(mdp, mdp_verif) == 0) {
        return 1;
    } else {
        return 0;
    }
}

// Fonction pour afficher les informations des reservations
void afficherReservations() {
    int i;
    printf("\n--- Informations des reservations ---\n");
    for (i = 0; i < reservationCount; i++) {
        printf("Service: %s, Places occupees: %d, Duree: %d heures\n",
               reservations[i].service, reservations[i].placesOccupees, reservations[i].duree);
    }
}

// Fonction pour reserver des chambres
void reserverChambres() {
    int typeChambre, nombreChambres;
    printf("Choisissez le type de chambre:\n1. Chambre a un lit\n2. Chambre a deux lits\n");
    scanf("%d", &typeChambre);

    if (typeChambre == 1) {
        printf("Nombre de chambres a reserver (disponibles: %d): ", chambresUnLit);
        scanf("%d", &nombreChambres);
        if (nombreChambres <= chambresUnLit && nombreChambres > 0) {
            chambresUnLit -= nombreChambres;
            printf("Reservation reussie de %d chambre(s) a un lit.\n", nombreChambres);
            // Enregistrer la reservation
            reservations[reservationCount++] = (Reservation){"Chambre a un lit", nombreChambres, 1}; // Duree fictive
        } else {
            printf("Aucune chambre disponible ou nombre de chambres impossible. Chambres disponibles: %d\n", chambresUnLit);
        }
    } else if (typeChambre == 2) {
        printf("Nombre de chambres a reserver (disponibles: %d): ", chambresDeuxLits);
        scanf("%d", &nombreChambres);
        if (nombreChambres <= chambresDeuxLits && nombreChambres > 0) {
            chambresDeuxLits -= nombreChambres;
            printf("Reservation reussie de %d chambre(s) a deux lits.\n", nombreChambres);
            // Enregistrer la reservation
            reservations[reservationCount++] = (Reservation){"Chambre a deux lits", nombreChambres, 1}; // Duree fictive
        } else {
            printf("Aucune chambre disponible ou nombre de chambres impossible. Chambres disponibles: %d\n", chambresDeuxLits);
        }
    } else {
        printf("Choix invalide.\n");
    }
}

