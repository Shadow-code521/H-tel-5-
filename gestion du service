// Fonction principale
int main() {
    int choixService, choix;
    do {
        printf("\n--- Menu de l'hotel CHAOS ---\n");
        printf("1. Service de CHAOS\n");
        printf("2. Administration\n");
        printf("3. Quitter\n");
        printf("Entrez votre choix: ");
        scanf("%d", &choixService);

        switch (choixService) {
            case 1:
                do {
                    printf("\n--- Services disponibles ---\n");
                    printf("1. Reservation de chambres\n");
                    printf("2. Reservation au restaurant\n");
                    printf("3. Reservation de la piscine\n");
                    printf("4. Reservation du spa\n");
                    printf("5. Reservation du sauna\n");
                    printf("6. Reservation de la salle de sport\n");
                    printf("7. Reservation de massage\n");
                    printf("8. Reservation d'un Chauffeur\n");
                    printf("9. Retour au menu principal\n");
                    printf("Entrez votre choix: ");
                    scanf("%d", &choix);

                    switch (choix) {
                        case 1:
                            reserverChambres();
                            break;
                        case 2:
                            reserverRestaurant();
                            break;
                        case 3:
                            reserverPiscine();
                            break;
                        case 4:
                            reserverSpa();
                            break;
                        case 5:
                            reserverSauna();
                            break;
                        case 6:
                            reserverSalleDeSport();
                            break;
                        case 7:
                            reserverMassage();
                            break;
                        case 8:
                            reserverchauffeur();
                            break;
                        case 9:
                            printf("Retour au menu principal.\n");
                            break;
                        default:
                            printf("Choix invalide. Veuillez reessayer.\n");
                    }
                } while (choix != 8);
                break;
            case 2:
                afficherReservations();
                break;
            case 3:
                printf("Merci d'avoir utilise le systeme de reservation.\n");
                break;
            default:
                printf("Choix invalide. Veuillez reessayer.\n");
        }
    } while (choixService != 3);

    return 0;
}
